# ===== Phase 0 account values — CEO fills these in from the dashboards =====
# Reloadly (Developers > API settings, SANDBOX toggle ON for test keys)
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true
# Stripe (Developers > API keys — TEST keys first, they start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Firebase (project settings — used from Phase 2 auth; not needed for Phase 1 core tests)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_ENABLED=false
# ===== App settings =====
PORT=3000
DATABASE_URL=postgresql://topup:topup@localhost:5432/topup
REDIS_URL=redis://localhost:6379
# Currency customers are charged in (Stripe account currency)
CHARGE_CURRENCY=EUR
# Our margin: fee = max(FEE_MIN_MINOR, ceil(cost * FEE_BPS/10000) + FEE_FIXED_MINOR)
FEE_BPS=800
FEE_FIXED_MINOR=35
FEE_MIN_MINOR=49
